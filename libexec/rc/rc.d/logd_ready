#!/bin/sh
# PROVIDE: logd_ready
# REQUIRE: FILESYSTEMS mountcritremote
# BEFORE: newsyslog syslogd SERVERS
# KEYWORD: nojail

. /etc/rc.subr
name="logd_ready"
desc="Publish filesystem readiness to the launchd logger (and load it on a legacy root)"
start_cmd="logd_ready_start"
stop_cmd=":"

logd_ready_start()
{
	# No logger, socket or pidfile is required here. The binary boot token
	# prevents an old marker from releasing a job during a later boot.
	(umask 077; /sbin/sysctl -bn kern.boottime > /var/run/logd.filesystems-ready.tmp) || return 1
	mv -f /var/run/logd.filesystems-ready.tmp /var/run/logd.filesystems-ready || return 1
	(umask 077; : > /var/run/logd.boot-service.log) || return 1

	# org.rmxos.logd's Mach service may exist only while logd can receive.
	# Sealed layout: launchd loaded it before /etc/rc; publish only.  Legacy
	# read-write root (transitional, retires with that layout): load it here,
	# after the marker, once.
	local jobs attempt owner
	jobs=$(/bin/timeout -k 1 10 /bin/launchctl list) || {
		warn "logd job list unavailable during filesystem readiness"
		return 1
	}
	if ! printf '%s\n' "$jobs" | /usr/bin/grep -q 'org\.rmxos\.logd$'; then
		/bin/timeout -k 1 10 /bin/launchctl load /etc/launchd.d/org.rmxos.logd.plist || return 1
	fi

	# Complete the startup handshake here, before syslogd's compatibility
	# dependency runs.  Do not leave dependent services to race daemon init.
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		owner=$(check_pidfile /var/run/syslog.pid /usr/sbin/logd)
		if [ -S /var/run/log ] && [ -n "$owner" ]; then
			return 0
		fi
		sleep 0.1
		attempt=$((attempt + 1))
	done
	warn "logd startup handshake failed before logging dependency"
	return 1
}

load_rc_config "$name"
run_rc_command "$1"
