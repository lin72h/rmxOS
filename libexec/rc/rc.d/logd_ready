#!/bin/sh
# PROVIDE: logd_ready
# REQUIRE: FILESYSTEMS mountcritremote
# BEFORE: newsyslog syslogd SERVERS
# KEYWORD: nojail

. /etc/rc.subr
name="logd_ready"
desc="Publish filesystem readiness to the launchd logger"
start_cmd="logd_ready_start"
stop_cmd=":"

logd_ready_start()
{
	# No logger, socket or pidfile is required here. The binary boot token
	# prevents an old marker from releasing a job during a later boot.
	(umask 077; /sbin/sysctl -bn kern.boottime > /var/run/logd.filesystems-ready.tmp) || return 1
	mv -f /var/run/logd.filesystems-ready.tmp /var/run/logd.filesystems-ready || return 1
	(umask 077; : > /var/run/logd.boot-service.log) || return 1

	# launchd loads org.rmxos.logd before /etc/rc (li-915 § Ownership); this
	# script only publishes readiness and never loads a launchd job.
	local attempt owner

	# Complete the startup handshake here, before syslogd's compatibility
	# dependency runs.  Do not leave dependent services to race daemon init.
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		owner=$(check_pidfile /var/run/syslog.pid /usr/sbin/logd)
		if [ -S /var/run/log ] && [ -n "$owner" ]; then
			return 0
		fi
		sleep 0.1
		attempt=$((attempt + 1))
	done
	warn "logd startup handshake failed before logging dependency"
	return 1
}

load_rc_config "$name"
run_rc_command "$1"
