#!/bin/sh
#
#

# PROVIDE: cleanvar
# REQUIRE: var
# BEFORE:  FILESYSTEMS

. /etc/rc.subr

name="cleanvar"
desc="Purge /var directory"
rcvar="cleanvar_enable"

start_precmd="${name}_prestart"
start_cmd="${name}_start"
stop_cmd=":"

extra_commands="reload"
reload_cmd="${name}_start"

cleanvar_prestart()
{
	# These files must be removed only the first time this script is run
	# on boot.
	#
	rm -f /var/run/clean_var /var/spool/lock/clean_var
}

cleanvar_start()
{
	local logd_pidfile

	if [ -d /var/run -a ! -f /var/run/clean_var ]; then
		# On a sealed root launchd starts logd before rc.  Its pidfile
		# carries the daemon's lifetime lock and the readiness handshake;
		# unlinking it leaves a live socket with no discoverable owner.
		# Keep only a live logd's file, so stale pidfiles are still purged.
		logd_pidfile=
		if [ -n "$(check_pidfile /var/run/syslog.pid /usr/sbin/logd)" ]; then
			logd_pidfile=/var/run/syslog.pid
		fi
		# Skip over logging sockets
		find -x /var/run \( -type f ! -path "$logd_pidfile" -or -type s ! -name log -and ! -name logpriv \) -delete
		>/var/run/clean_var
	fi
	if [ -d /var/spool/lock -a ! -f /var/spool/lock/clean_var ]; then
		find -x /var/spool/lock -type f -delete
		>/var/spool/lock/clean_var
	fi
	if [ -d /var/spool/uucp/.Temp ]; then
		find -x /var/spool/uucp/.Temp -delete
	fi
}

load_rc_config $name

# doesn't make sense to run in a svcj
cleanvar_svcj="NO"

run_rc_command "$1"
