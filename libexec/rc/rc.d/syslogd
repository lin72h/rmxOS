#!/bin/sh
# Compatibility service for the asld system logger.
# PROVIDE: syslogd
# REQUIRE: mountcritremote FILESYSTEMS asld_ready
# BEFORE: SERVERS

. /etc/rc.subr
name="syslogd"
desc="Wait for asld and provide compatible reload/status commands"
command="/usr/sbin/asld"
pidfile="/var/run/syslog.pid"
start_cmd="asld_wait"
# start waits for an already running launchd-owned process.
rc_fast=yes
stop_cmd=":"
extra_commands="reload"

asld_wait()
{
	local attempt owner
	attempt=0
	while [ "$attempt" -lt 30 ]; do
		owner=$(check_pidfile "$pidfile" "$command")
		if [ -S /var/run/log ] && [ -n "$owner" ]; then
			(umask 077; echo "$owner" > /var/run/asld.service-ready) || return 1
			echo "asld: compatibility service ready pid=$owner socket=/var/run/log"
			return 0
		fi
		sleep 1
		attempt=$((attempt + 1))
	done
	warn "asld socket not ready after 30 seconds; logging dependency unavailable"
	return 1
}

load_rc_config "$name"
run_rc_command "$1"
