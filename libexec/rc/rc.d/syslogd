#!/bin/sh
#
#

# netif is required for lo0 because syslogd tries to open a local socket
#
# PROVIDE: syslogd
# REQUIRE: mountcritremote FILESYSTEMS newsyslog netif
# BEFORE:  SERVERS

. /etc/rc.subr

name="syslogd"
desc="System log daemon"
rcvar="syslogd_enable"
pidfile="/var/run/syslog.pid"
command="/usr/sbin/${name}"
required_files="/etc/syslog.conf"
start_precmd="syslogd_precmd"
extra_commands="reload"

sockfile="/var/run/syslogd.sockets"
evalargs="rc_flags=\"\`set_socketlist\` \$rc_flags\""

: ${syslogd_svcj_options:="net_basic"}

syslogd_precmd()
{
	local _l _ldir
	local _asld

	# Never unlink a live asld socket before syslogd obtains the shared lock.
	_asld=$(check_pidfile "$pidfile" /usr/sbin/asld)
	if [ -n "$_asld" ]; then
		warn "asld is running (pid $_asld); unload com.apple.syslogd first"
		return 1
	fi

	# The marked routes are handled by asl.conf when asld is the logger.
	# Restore them, including the program filter, for the syslogd fallback.
	case " $rc_flags " in
	*" -f "*) ;;
	*)
		if grep -q '^# syslogd-fallback: ' /etc/syslog.conf; then
			sed 's/^# syslogd-fallback: //' /etc/syslog.conf > /var/run/syslogd-fallback.conf || return 1
			rc_flags="$rc_flags -f /var/run/syslogd-fallback.conf"
		fi
		;;
	esac

	#	Transitional symlink for old binaries
	#
	if [ ! -L /dev/log ] && ! check_jail jailed; then
		ln -sf /var/run/log /dev/log
	fi
	rm -f /var/run/log

	#	Create default list of syslog sockets to watch
	#
	( umask 022 ; > $sockfile )

	#	If running named(8) or ntpd(8) chrooted, added appropriate
	#	syslog socket to list of sockets to watch.
	#
	for _l in $altlog_proglist; do
		eval _ldir=\$${_l}_chrootdir
		if checkyesno ${_l}_enable && [ -n "$_ldir" ]; then
			echo "${_ldir}/var/run/log" >> $sockfile
		fi
	done

	#	If other sockets have been provided, change run_rc_command()'s
	#	internal copy of $syslogd_flags to force use of specific
	#	syslogd sockets.
	#
	if [ -s $sockfile ]; then
		echo "/var/run/log" >> $sockfile
		eval $evalargs
	fi

	return 0
}

set_socketlist()
{
	local _s _socketargs

	_socketargs=
	for _s in `cat $sockfile | tr '\n' ' '` ; do
		_socketargs="-l $_s $_socketargs"
	done
	echo $_socketargs
}
load_rc_config $name
run_rc_command "$1"
