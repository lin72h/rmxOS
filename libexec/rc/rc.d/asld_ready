#!/bin/sh
# PROVIDE: asld_ready
# REQUIRE: FILESYSTEMS mountcritremote
# BEFORE: newsyslog syslogd SERVERS
# KEYWORD: nojail

. /etc/rc.subr
name="asld_ready"
desc="Start the launchd logger after filesystem setup"
start_cmd="asld_ready_start"
stop_cmd=":"

asld_ready_start()
{
	# No logger, socket or pidfile is required here. The binary boot token
	# prevents an old marker from releasing a job during a later boot.
	(umask 077; /sbin/sysctl -bn kern.boottime > /var/run/asld.filesystems-ready.tmp) || return 1
	mv -f /var/run/asld.filesystems-ready.tmp /var/run/asld.filesystems-ready || return 1
	(umask 077; : > /var/run/asld.boot-service.log) || return 1

	# Some retained bootstrappers load jobs only after rc returns.  Publish
	# filesystem readiness, then load this one job if it is not loaded yet.
	# Current bootstrappers have already loaded it: leave that job alone.
	local jobs attempt owner
	jobs=$(/bin/timeout -k 1 10 /bin/launchctl list) || {
		warn "asld job list unavailable during filesystem readiness"
		return 1
	}
	if ! printf '%s\n' "$jobs" | /usr/bin/grep -qx com.apple.syslogd; then
		/bin/timeout -k 1 10 /bin/launchctl load /etc/launchd.d/com.apple.syslogd.plist || return 1
	fi

	# Complete the startup handshake here, before syslogd's compatibility
	# dependency runs.  Do not leave dependent services to race daemon init.
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		owner=$(check_pidfile /var/run/syslog.pid /usr/sbin/asld)
		if [ -S /var/run/log ] && [ -n "$owner" ]; then
			return 0
		fi
		sleep 0.1
		attempt=$((attempt + 1))
	done
	warn "asld startup handshake failed before logging dependency"
	return 1
}

load_rc_config "$name"
run_rc_command "$1"
