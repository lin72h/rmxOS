/* task_get_special_port wire ID/types, with bounded send/receive waits. */
subsystem op547_kernel 3409;
#include <sys/mach/std_types.defs>
#include <sys/mach/mach_types.defs>
waittime 2000;
sendtime 2000;
routine op547_kernel_special(target_task: task_t; which_port: int;
    out special_port: mach_port_t);
