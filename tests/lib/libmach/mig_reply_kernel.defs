/* The task_info wire ID/types, with test-only bounded send and receive waits. */
subsystem op547_kernel 3405;
#include <sys/mach/std_types.defs>
#include <sys/mach/mach_types.defs>
waittime 2000;
sendtime 2000;
routine op547_kernel_info(target_task: task_name_t; flavor: task_flavor_t;
    out task_info_out: task_info_t, CountInOut);
